<UserControl x:Class="AudioScrub.AudioScrubSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Margin="12" MaxWidth="420">
    <CheckBox Content="シーク時に1フレームの音声を再生する"
              IsChecked="{Binding Enabled}"
              Margin="0,0,0,8"/>
    <TextBlock Text="音量 (%)" Margin="0,4,0,2"/>
    <Slider Minimum="0" Maximum="200" Value="{Binding Volume}" TickFrequency="10"/>
    <TextBlock Text="{Binding Volume, StringFormat={}{0:0}%}" Margin="0,0,0,8"/>
    <TextBlock Text="再生フレーム数" Margin="0,4,0,2"/>
    <Slider Minimum="1" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True"
            Value="{Binding FrameCount, UpdateSourceTrigger=PropertyChanged}"/>
    <TextBlock Text="{Binding FrameCount, StringFormat={}{0} フレーム}" />
    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Opacity="0.75"
               Text="タイムライン停止中にシークバーを動かすと、その位置のミックス音声を短く再生します。再生中はスクラブしません。"/>
    <TextBlock Margin="0,8,0,0" Opacity="0.6" Text="バージョン 1.0.0"/>
  </StackPanel>
</UserControl>
