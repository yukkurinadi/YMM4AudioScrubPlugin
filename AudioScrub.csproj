<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyName>AudioScrub</AssemblyName>
    <RootNamespace>AudioScrub</RootNamespace>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="YukkuriMovieMaker.Plugin">
      <HintPath>C:\YMM4\YukkuriMovieMaker.Plugin.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="NAudio.Core">
      <HintPath>C:\YMM4\NAudio.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NAudio.Wasapi">
      <HintPath>C:\YMM4\NAudio.Wasapi.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NAudio.WinMM">
      <HintPath>C:\YMM4\NAudio.WinMM.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
  </ItemGroup>

  <Target Name="CopyToPlugin" AfterTargets="Build">
    <MakeDir Directories="C:\YMM4\user\plugin\AudioScrub" />
    <ItemGroup>
      <_PluginOut Include="$(OutputPath)$(AssemblyName).dll" />
      <_PluginOut Include="$(OutputPath)0Harmony.dll" Condition="Exists('$(OutputPath)0Harmony.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(_PluginOut)" DestinationFolder="C:\YMM4\user\plugin\AudioScrub" SkipUnchangedFiles="false" ContinueOnError="true" />
  </Target>

</Project>
